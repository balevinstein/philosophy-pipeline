# Philosophy Pipeline Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==============================================================================
# API KEYS (REQUIRED)
# ==============================================================================

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
# Required for GPT model interactions
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key  
# Get your API key from: https://console.anthropic.com/settings/keys
# Required for Claude model interactions (primary model used)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# ==============================================================================
# ENVIRONMENT CONFIGURATION (OPTIONAL)
# ==============================================================================

# Override the default environment detection
# Valid values: "development", "production"
# Default: "development"
# PHILOSOPHY_PIPELINE_ENV=development

# Override the default configuration directory path
# Default: "./config" (relative to project root)
# PHILOSOPHY_PIPELINE_CONFIG_PATH=/path/to/custom/config

# ==============================================================================
# LOGGING AND DEBUGGING (OPTIONAL)
# ==============================================================================

# Override log level for all pipeline operations
# Valid values: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: Set by environment configuration
# PHILOSOPHY_PIPELINE_LOG_LEVEL=INFO

# Enable/disable verbose output for debugging
# Valid values: "true", "false"
# Default: Set by environment configuration
# PHILOSOPHY_PIPELINE_VERBOSE=false

# ==============================================================================
# PERFORMANCE AND RELIABILITY (OPTIONAL)
# ==============================================================================

# Override API request timeout (seconds)
# Default: 300 seconds (5 minutes)
# PHILOSOPHY_PIPELINE_API_TIMEOUT=300

# Override maximum API retry attempts
# Default: 5
# PHILOSOPHY_PIPELINE_MAX_RETRIES=5

# Override rate limiting wait time (seconds)
# Default: Set by configuration
# PHILOSOPHY_PIPELINE_RATE_LIMIT_WAIT=60

# ==============================================================================
# DEVELOPMENT SPECIFIC (OPTIONAL)
# ==============================================================================

# Enable development mode features (bypasses some validations)
# Valid values: "true", "false"  
# Default: "false"
# PHILOSOPHY_PIPELINE_DEV_MODE=false

# Override cache directory for development
# Default: "./cache" or system temp directory
# PHILOSOPHY_PIPELINE_CACHE_DIR=/path/to/cache

# Enable performance profiling for development
# Valid values: "true", "false"
# Default: "false"  
# PHILOSOPHY_PIPELINE_PROFILE=false

# ==============================================================================
# PRODUCTION SPECIFIC (OPTIONAL)
# ==============================================================================

# Enable production monitoring and metrics
# Valid values: "true", "false"
# Default: "false"
# PHILOSOPHY_PIPELINE_MONITORING=false

# Production deployment identifier
# Used for logging and monitoring in production environments
# PHILOSOPHY_PIPELINE_DEPLOYMENT_ID=prod-v1.0.0

# Health check endpoint port (if running as service)
# Default: Not enabled
# PHILOSOPHY_PIPELINE_HEALTH_PORT=8080

# ==============================================================================
# INTEGRATION SETTINGS (OPTIONAL)
# ==============================================================================

# Database connection string (future use)
# PHILOSOPHY_PIPELINE_DATABASE_URL=postgresql://user:pass@localhost/pipeline

# External API endpoints (future use)
# PHILOSOPHY_PIPELINE_EXTERNAL_API_BASE=https://api.example.com

# ==============================================================================
# FILE SYSTEM PATHS (OPTIONAL)
# ==============================================================================

# Override default output directory
# Default: "./outputs" (relative to project root)
# PHILOSOPHY_PIPELINE_OUTPUT_DIR=/path/to/outputs

# Override default papers directory  
# Default: "./papers" (relative to project root)
# PHILOSOPHY_PIPELINE_PAPERS_DIR=/path/to/papers

# Override temporary files directory
# Default: System temporary directory
# PHILOSOPHY_PIPELINE_TEMP_DIR=/path/to/temp

# ==============================================================================
# SECURITY (OPTIONAL)
# ==============================================================================

# API key encryption key (for secure storage in production)
# Generate with: openssl rand -hex 32
# PHILOSOPHY_PIPELINE_ENCRYPTION_KEY=your-32-character-hex-key-here

# Enable/disable API key validation at startup
# Valid values: "true", "false"
# Default: "true"
# PHILOSOPHY_PIPELINE_VALIDATE_KEYS=true

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Never commit your actual .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. In production, consider using a secrets management system
# 4. Test your configuration with: python pipeline_cli.py validate
# 5. Environment variables always override configuration file settings